+  function view(st) {
+    if (!st || st.available === false) return { available: false, headline: 'No strategy library yet', detail: (st && st.message) || 'Run Record Situations, then Precompute Strategies.', rows: [] };
+    const pc = st.precompute || null, c = pc ? pc.counts : null, run = pc && pc.running ? pc.running : [];
