+  /** Decode a body. With a SharedArrayBuffer-backed input the numeric arrays are views on that memory (no copy). */
+  function decode(bytes) {
+    ok(bytes && bytes.length >= 12 && bytes[0] === 0x45 && bytes[1] === 0x4d && bytes[2] === 0x53 && bytes[3] === 0x53, 'Not a street snapshot');
+    const dv = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength); ok(dv.getUint32(4, true) === VERSION, 'Unsupported snapshot version');
