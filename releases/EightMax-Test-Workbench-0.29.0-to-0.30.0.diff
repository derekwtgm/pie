+  }
+
+  /** Read-only stand-in for a prepared EightMax game: view() and averageAt() for the snapshotted street. */
+  class SnapshotGame {
+    constructor(meta, probs, ev, keys, bytes) {
+      this.meta = meta; this.probs = probs; this.ev = ev; this.keys = keys; this.bytes = bytes || 0;
+      this.byPath = new Map(meta.nodes.map((n) => [n.p, n]));
+      for (const n of meta.nodes) if (n.kind === 'player') { ok(n.ro + n.rc <= keys.length && n.po + n.rc * n.k <= probs.length, 'Snapshot node out of range'); }
+    }
+    get iterations() { return this.meta.iterations; }
+    _row(n, key) { let lo = n.ro, hi = n.ro + n.rc - 1; while (lo <= hi) { const m = (lo + hi) >> 1, x = this.keys[m]; if (x === key) return m - n.ro; if (x < key) lo = m + 1; else hi = m - 1; } return -1; }
+    view(steps) {
+      const n = this.byPath.get('r' + steps.join(''));
+      if (!n) return { kind: 'outside-snapshot' };
+      if (n.kind !== 'player') return n.kind === 'terminal' && n.behind ? { kind: n.kind, pot: n.pot, behind: n.behind, live: n.live } : { kind: n.kind };
+      const hands = [];
+      for (let i = 0; i < n.rc; i++) { const off = n.po + i * n.k; if (Number.isNaN(this.ev[off])) continue; const key = this.keys[n.ro + i]; hands.push({ cards: cs(Math.floor(key / 52)) + cs(key % 52), ev: Array.from(this.ev.subarray(off, off + n.k)) }); }
+      return { kind: 'player', seat: n.seat, pot: n.pot, behind: n.behind, live: n.live, actions: n.labels.map((label) => ({ label })), hands };
+    }
+    averageAt(path, board, seat, h) {
+      const n = this.byPath.get(path); if (!n || n.kind !== 'player' || n.seat !== seat) return null;
+      const i = this._row(n, pairKey(h.a, h.b)); if (i < 0) return null;
+      const off = n.po + i * n.k; return Float64Array.from(this.probs.subarray(off, off + n.k));
+    }
+    /** Shape TreeStudy expects of a prepared study. */
+    prepared(config) { return { game: this, spec: { hands: this.meta.hands, board: this.meta.board }, options: { config: config || null } }; }
+  }
+
+  return { VERSION, exportStreet, encode, decode, SnapshotGame, pairKey };
+});
