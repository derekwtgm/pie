+'use strict';
+/* EightMax Test Workbench 0.30: one copy of each loaded strategy for all table worker threads.
+ *
+ * The host (main thread) owns a StrategyLibrary opened with sharedMemory:true, so each verified record body is decoded into a
+ * SharedArrayBuffer. A worker that misses in its own small cache asks the host over a MessagePort; the host loads the record
+ * once (all integrity and identity checks happen there) and posts the SharedArrayBuffer. Posting a SharedArrayBuffer shares
+ * the memory, it does not copy it, so ten tables on four workers read the same bytes. The data is never written after it
+ * is loaded (records are immutable), so readers need no locks. Workers still re-check the identity they asked for against
+ * the record header before using it.
+ */
+const { MessageChannel } = require('node:worker_threads');
+const SID = require('./strategy-identity.js'), SNAP = require('./strategy-snapshot.js');
+const nowMs = () => Number(process.hrtime.bigint()) / 1e6;
+
+class SharedStrategyHost {
+  constructor(library) {
+    if (!library.o.sharedMemory) throw new Error('Open the host library with sharedMemory:true');
+    this.lib = library; this.ports = []; this.stats = { requests: 0, served: 0, misses: 0, refused: 0, sharedBytes: 0, sharedRecords: 0 }; this.shared = new Map();
+  }
+  /** A port to hand to one worker (put it in workerData and in the Worker transferList). */
+  port() {
+    const ch = new MessageChannel(); this.ports.push(ch.port1);
+    ch.port1.on('message', (m) => {
+      if (!m || m.type !== 'fetch') return; this.stats.requests++;
+      const r = this.lib.get(m.identity, m.fingerprint);
+      if (!r.ok) { if (r.code === 'library-miss') this.stats.misses++; else this.stats.refused++; ch.port1.postMessage({ type: 'fetched', id: m.id, ok: false, code: r.code, reason: r.reason }); return; }
