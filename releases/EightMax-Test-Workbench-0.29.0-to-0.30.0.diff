+      engine: { version: input.engine.version, build: input.engine.build },
+      rules: { variant: 'no-limit-holdem', tableSeats: 8, blinds: { sb: input.blinds.sb, bb: input.blinds.bb, ante: input.blinds.ante || 0 }, chipUnit: '100 chips = 1 BB' },
