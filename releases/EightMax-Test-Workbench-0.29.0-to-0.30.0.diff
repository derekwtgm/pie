index 0000000..775f62f
--- /dev/null
+++ b/src/strategy-snapshot.js
@@ -0,0 +1,105 @@
+/* EightMax Test Workbench 0.30: compact, immutable snapshot of one street of a trained study.
+ *
+ * Why: a full native EightMax state for a postflop study is 5-20 MB and importing it takes 0.3-1.6 s (measured on the
+ * development machine, docs/STRATEGY-LIBRARY.md) - longer than training it. A decision at the start-of-street study only
+ * ever reads nodes of that street, so the snapshot keeps exactly those: every decision node of the street (seat, pot,
+ * stacks behind, live flags, menu labels), the study's range rows, and for each node the engine's average strategy for
+ * every stored hand, as IEEE-754 doubles copied from averageAt(). Nothing is recomputed, rounded or smoothed: a snapshot
+ * answers averageAt() bit-for-bit like the trained game it was exported from (tests/strategy-library-030 checks this).
+ * Nodes behind a chance or terminal node are recorded only by kind; the next street has its own study.
+ *
+ * Binary body (little-endian):  "EMSS" | u32 version | u32 metaLen | meta JSON | pad to 8 | f64 probs[] | f64 ev[] | u16 keys[]
+ * The library wraps the body with its own header, checksum and compression (src/strategy-library.js).
+ */
+(function (root, factory) {
+  if (typeof module === 'object' && module.exports) module.exports = factory();
+  else root.WorkbenchStrategySnapshot = factory();
+})(typeof globalThis !== 'undefined' ? globalThis : this, function () {
+  'use strict';
+  const VERSION = 1, RANKS = '23456789TJQKA', SUITS = 'cdhs';
+  const ok = (x, m) => { if (!x) throw new Error(m); };
+  const cs = (c) => RANKS[c >> 2] + SUITS[c & 3];
+  const pairKey = (a, b) => (a < b ? a * 52 + b : b * 52 + a);
+
+  /** Export the current street of a prepared, trained game. Returns { meta, probs:Float64Array, ev:Float64Array, keys:Uint16Array }. */
+  function exportStreet(prepared, options = {}) {
+    const g = prepared.game, spec = prepared.spec, nodes = [], probs = [], ev = [], keys = [];
+    const maxNodes = options.maxNodes || 20000; let rowTotal = 0;
+    const queue = [[]];
+    // averageAt() re-evaluates the (board + hand) strength on every call although it does not depend on the node. When the engine
+    // library is supplied, its pure evalCards() is memoised for the duration of the export (restored afterwards; results identical).
+    const EMlib = options.EM, origEval = EMlib && EMlib.evalCards, memo = new Map();
+    if (origEval) EMlib.evalCards = function (cards) { const k = cards.join(','); let v = memo.get(k); if (v === undefined) { v = origEval.apply(this, arguments); memo.set(k, v); } return v; };
+    try {
+    while (queue.length) {
+      const steps = queue.shift(), v = g.view(steps), path = 'r' + steps.join('');
+      if (v.kind !== 'player') { nodes.push(v.kind === 'terminal' ? { p: path, kind: v.kind, pot: v.pot, behind: v.behind, live: v.live } : { p: path, kind: v.kind }); continue; }   // 0.30: terminal geometry kept for independent exact evaluation
+      ok(nodes.length < maxNodes, 'Street has more than ' + maxNodes + ' nodes; refusing to snapshot');
+      const labels = v.actions.map((a) => a.label), k = labels.length, evBy = new Map();
+      for (const h of v.hands || []) if (Array.isArray(h.ev) && h.ev.length === k) evBy.set(h.cards, h.ev);
+      const rows = [];
+      for (const r of spec.hands[v.seat]) {
+        const pr = g.averageAt(path, spec.board, v.seat, { id: r[0], a: r[1], b: r[2], w: r[3] });
+        if (!pr) continue; ok(pr.length === k, 'Strategy width differs from the menu at ' + path);
+        rows.push({ key: pairKey(r[1], r[2]), pr, ev: evBy.get(cs(r[1]) + cs(r[2])) || evBy.get(cs(r[2]) + cs(r[1])) || null });
+      }
+      rows.sort((x, y) => x.key - y.key);
+      const node = { p: path, kind: 'player', seat: v.seat, pot: v.pot, behind: v.behind, live: v.live, labels, k, ro: rowTotal, rc: rows.length, po: probs.length };
+      for (const r of rows) { keys.push(r.key); for (let i = 0; i < k; i++) { probs.push(r.pr[i]); ev.push(r.ev ? r.ev[i] : NaN); } }
