@@ -0,0 +1,84 @@
+'use strict';
+/* 0.30 precomputation queue, checkpoint continuation, throttling, shared strategy memory across threads, and the
+ * end-to-end simulator with the library (Study Mode pass, then a Decision Mode replay that must train nothing). */
+const test = require('node:test'), assert = require('node:assert/strict');
+const fs = require('node:fs'), os = require('node:os'), path = require('node:path'), { Worker } = require('node:worker_threads');
+const L = require('../src/strategy-library.js'), LS = require('../src/library-source.js'), { PrecomputeQueue } = require('../src/precompute.js');
+const { cliPath } = require('../tools/train-study.cjs');
+const tmp = () => fs.mkdtempSync(path.join(os.tmpdir(), 'em-pre-test-'));
+const cards = (s) => s.match(/../g);
+const spot = (pot, it = 1200, street = 'river') => LS.spotFromParams({ street, board: cards(street === 'river' ? 'AsKd7h4c2s' : street === 'turn' ? 'AsKd7h4c' : 'AsKd7h'), stacksBehind: [10, 10], pot }, { iterations: it, trainerName: 'javascript-reference-cpu' }).spot;
+
+test('queue: priority order, de-duplication, already-stored detection, only completed studies stored', async () => {
+  const lib = L.StrategyLibrary.open(tmp()), q = new PrecomputeQueue({ library: lib, reserveMiB: 0, memoryMiB: 1 }); q.pause(); const order = [];
+  q.on((e) => { if (e.type === 'started') order.push(e.job.priority); });
+  q.enqueue(spot(4), { priority: 1 }); q.enqueue(spot(5), { priority: 9 }); q.enqueue(spot(6), { priority: 5 });
+  assert.equal(q.enqueue(spot(5), { priority: 2 }).priority, 9, 'duplicate keeps the higher priority'); assert.equal(q.stats.duplicates, 1);
+  q.start(); await q.drain(); assert.deepEqual(order, [9, 5, 1]); assert.equal(q.status().counts.complete, 3); assert.equal(lib.list().length, 3);
+  assert.equal(q.enqueue(spot(4)).status, 'already-stored');
+  for (const e of lib.list()) assert.equal(e.convergence, 'unproven', 'completed is not converged');
+});
+test('worker-thread mode: jobs train in their own threads, results identical to in-thread training, cancellation still works', async () => {
+  const a = L.StrategyLibrary.open(tmp()), b = L.StrategyLibrary.open(tmp()), s1 = spot(4), s2 = spot(5);
+  const qa = new PrecomputeQueue({ library: a, reserveMiB: 0, memoryMiB: 1, workerThreads: true, concurrency: 2 }); qa.enqueue(s1); qa.enqueue(s2); await qa.drain();
+  const qb = new PrecomputeQueue({ library: b, reserveMiB: 0, memoryMiB: 1 }); qb.enqueue(s1); qb.enqueue(s2); await qb.drain();
+  for (const s of [s1, s2]) assert.deepEqual(Array.from(a.get(s.identity).game.probs), Array.from(b.get(s.identity).game.probs));
+  const qc = new PrecomputeQueue({ library: L.StrategyLibrary.open(tmp()), reserveMiB: 0, memoryMiB: 1, workerThreads: true, chunkUpdates: 100 }); const big = spot(6, 80000); qc.enqueue(big);
+  qc.on((e) => { if (e.type === 'progress' && e.job.progress > 0.01) qc.cancel(big.fingerprint); }); await qc.drain(); assert.equal(qc.jobs.get(big.fingerprint).status, 'cancelled');
+});
+test('cancellation: a queued job is cancelled; a running job is aborted and nothing is stored', async () => {
+  const lib = L.StrategyLibrary.open(tmp()), q = new PrecomputeQueue({ library: lib, reserveMiB: 0, memoryMiB: 1, chunkUpdates: 100 }); q.pause();
