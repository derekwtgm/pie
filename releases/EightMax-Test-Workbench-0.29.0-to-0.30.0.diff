+    'no-stored-row': 'The study never reached this hand at this point during training; more training is needed.',
+    'player-count-unsupported': 'Too many players are still in the hand for the studies in this release (postflop: at most 6).',
+    'stakes-or-stack-mismatch': 'The stacks or blinds are outside what the studies cover.',
+    'state-mismatch': 'The table does not match the trained situation exactly (pot or stacks differ), so the strategy is not used.',
+    'street-not-covered': 'No study covers this betting round.',
+    'invalid-observation': 'The table reading is incomplete, so no decision is made.',
+    'checksum': 'A stored strategy file is damaged and was refused. Run Verify Strategies.',
+    'engine-mismatch': 'A stored strategy was trained by a different engine build and was refused.',
+    'identity-mismatch': 'A stored strategy does not match this situation exactly and was refused.',
+  };
