<!-- EightMax Test Workbench 0.33.0 - Windows Graphics Capture helper.
     STATUS: compiled (cross-compiled on Linux with the .NET 8 SDK, EnableWindowsTargeting=true). NOT executed on Windows.
     Prebuilt self-contained single-file exe ships as desktop\bin\EightMaxWgc.exe (no .NET install needed to RUN it).
     Rebuild on Windows: windows\Build-WgcCapture.ps1 (needs the .NET 8 SDK once). No package references beyond the SDK's own
     Windows SDK projection (Microsoft.Windows.SDK.NET.Ref) and runtime pack.
     0.29: target 10.0.22000 projection (from 0.27) while SupportedOSPlatformVersion stays 10.0.19041 (runs on Windows 10 2004+). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <AssemblyName>EightMaxWgc</AssemblyName>
    <Version>0.33.0</Version>
    <FileVersion>0.33.0.0</FileVersion>
    <InformationalVersion>0.33.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>EightMax Test Workbench</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
